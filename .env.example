ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
PORT=8000
# Only behind a reverse proxy, for example TRUST_PROXY=loopback. Leave unset otherwise.
TRUST_PROXY=
# Optional: mock or elevenlabs. Unset picks elevenlabs when the key and agent are configured.
SKILLPRINT_APPRENTICE_DEFAULT=
# Optional Python interpreter override; defaults to the project .venv-movement.
SKILLPRINT_MOVEMENT_PYTHON=
# Optional model path; requires the adjacent .provenance.json from the installer.
SKILLPRINT_RTMW3D_MODEL=
# CPU thread count (DirectML is selected when installed on Windows).
SKILLPRINT_INFERENCE_THREADS=4
